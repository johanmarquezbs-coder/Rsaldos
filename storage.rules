rules_version = '2';

// Reglas de Firebase Storage para las fotos de producto de R-Saldos.
// Publicar con: firebase deploy --only storage  (o copiar en Consola > Storage > Reglas).
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{productId}/{fileName} {
      // Las fotos del catálogo se pueden ver con sesión iniciada.
      allow read: if request.auth != null;
      // Solo usuarios autenticados suben imágenes JPEG/PNG de máximo 5 MB.
      allow create, update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
