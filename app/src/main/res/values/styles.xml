<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.RSaldos.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/rs_orange</item>
        <item name="android:textColor">@color/rs_white</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.RSaldos.Button.Dark" parent="Widget.RSaldos.Button.Primary">
        <item name="backgroundTint">@color/rs_graphite</item>
    </style>

    <style name="Widget.RSaldos.Button.Danger" parent="Widget.RSaldos.Button.Primary">
        <item name="backgroundTint">@color/rs_red</item>
    </style>

    <style name="Widget.RSaldos.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/rs_graphite</item>
        <item name="strokeColor">@color/rs_gray_line</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="iconTint">@color/rs_graphite</item>
    </style>

    <style name="Widget.RSaldos.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/rs_orange</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.RSaldos.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
        <item name="boxStrokeColor">@color/rs_orange</item>
        <item name="hintTextColor">@color/rs_orange</item>
        <item name="boxBackgroundColor">@color/rs_white</item>
        <item name="startIconTint">@color/rs_gray_text</item>
    </style>

    <style name="Widget.RSaldos.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_l</item>
        <item name="cardBackgroundColor">@color/rs_white</item>
        <item name="strokeColor">@color/rs_gray_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.RSaldos.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/rs_gray_line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">20dp</item>
    </style>

    <style name="Widget.RSaldos.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.RSaldos.Title</item>
    </style>

    <style name="TextAppearance.RSaldos.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/rs_graphite</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_headline</item>
    </style>

    <style name="TextAppearance.RSaldos.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/rs_graphite</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <style name="TextAppearance.RSaldos.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/rs_graphite</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <style name="TextAppearance.RSaldos.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/rs_graphite_soft</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.RSaldos.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/rs_gray_text</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="TextAppearance.RSaldos.Price" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/rs_graphite</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RSaldos.Badge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_badge</item>
    </style>

    <style name="RSaldos.SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_l</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
        <item name="android:textAppearance">@style/TextAppearance.RSaldos.Subtitle</item>
    </style>

    <style name="RSaldos.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/rs_orange_soft</item>
    </style>

    <style name="Widget.RSaldos.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
        <item name="boxStrokeColor">@color/rs_orange</item>
        <item name="hintTextColor">@color/rs_orange</item>
    </style>
</resources>
