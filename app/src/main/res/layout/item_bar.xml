<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvBarLabel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RSaldos.Body" />

    <ProgressBar
        android:id="@+id/pbBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_weight="1"
        android:max="100"
        android:progressDrawable="@drawable/bg_bar_track" />

    <TextView
        android:id="@+id/tvBarValue"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.RSaldos.Caption" />
</LinearLayout>
