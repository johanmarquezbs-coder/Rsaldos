<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_xl">

    <TextView
        android:id="@+id/tvOrderInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:textAppearance="@style/TextAppearance.RSaldos.Body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/dispatch_checklist"
        android:textAppearance="@style/TextAppearance.RSaldos.Subtitle" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbVerified"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dispatch_check_1" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbPacked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dispatch_check_2" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbInvoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dispatch_check_3" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCarrier"
        style="@style/Widget.RSaldos.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:hint="@string/field_carrier">

        <AutoCompleteTextView
            android:id="@+id/actCarrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTracking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:hint="@string/field_tracking">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTracking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
