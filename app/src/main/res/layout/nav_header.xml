<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_drawer_header"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="48dp"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_xl">

    <TextView
        android:id="@+id/tvHeaderAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_circle"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeaderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:textColor="@color/rs_white"
        android:textSize="@dimen/text_subtitle"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeaderEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/rs_orange_soft"
        android:textSize="@dimen/text_caption" />

    <TextView
        android:id="@+id/tvHeaderRole"
        style="@style/RSaldos.Badge"
        android:layout_marginTop="@dimen/space_s" />
</LinearLayout>
