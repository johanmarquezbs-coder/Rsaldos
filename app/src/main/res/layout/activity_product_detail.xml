<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rs_white"
    android:orientation="vertical">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="@drawable/bg_image_box">

                <ImageView
                    android:id="@+id/ivProduct"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:tint="@color/rs_graphite_soft" />

                <TextView
                    android:id="@+id/tvDiscount"
                    style="@style/RSaldos.Badge"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/space_m" />

                <TextView
                    android:id="@+id/tvPhotos"
                    style="@style/RSaldos.Badge"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/space_m" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGrade"
                    style="@style/RSaldos.Badge" />

                <TextView
                    android:id="@+id/tvCondition"
                    style="@style/RSaldos.Badge"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:id="@+id/tvStock"
                    style="@style/RSaldos.Badge"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.RSaldos.Title" />

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RSaldos.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rs_graphite"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOldPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_marginBottom="4dp"
                    android:layout_weight="1"
                    android:textColor="@color/rs_gray_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/detail_tax_included"
                    android:textAppearance="@style/TextAppearance.RSaldos.Caption" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_verified_state"
                        android:textAppearance="@style/TextAppearance.RSaldos.Subtitle" />

                    <TextView
                        android:id="@+id/tvTests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.RSaldos.Body"
                        app:drawableStartCompat="@drawable/ic_check_circle"
                        app:drawableTint="@color/rs_green" />

                    <TextView
                        android:id="@+id/tvWarranty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.RSaldos.Body"
                        app:drawableStartCompat="@drawable/ic_shield"
                        app:drawableTint="@color/rs_blue" />

                    <TextView
                        android:id="@+id/tvDefects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.RSaldos.Body"
                        app:drawableStartCompat="@drawable/ic_warning"
                        app:drawableTint="@color/rs_yellow" />

                    <TextView
                        android:id="@+id/tvDelivery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:text="@string/detail_delivery"
                        android:textAppearance="@style/TextAppearance.RSaldos.Body"
                        app:drawableStartCompat="@drawable/ic_truck"
                        app:drawableTint="@color/rs_orange" />

                    <TextView
                        android:id="@+id/tvSerial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:textAppearance="@style/TextAppearance.RSaldos.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/RSaldos.SectionTitle"
                android:text="@string/detail_description" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RSaldos.Body" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <TextView
                        android:id="@+id/tvSellerAvatar"
                        android:layout_width="@dimen/avatar_size"
                        android:layout_height="@dimen/avatar_size"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSellerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/rs_graphite"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSellerMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.RSaldos.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/detail_verified_seller"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/rs_green" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/detail_legal"
                android:textAppearance="@style/TextAppearance.RSaldos.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rs_white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <ImageView
            android:id="@+id/btnMinus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_search"
            android:contentDescription="@string/action_decrease"
            android:padding="9dp"
            android:src="@drawable/ic_minus" />

        <TextView
            android:id="@+id/tvQty"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/one"
            android:textColor="@color/rs_graphite"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnPlus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_search"
            android:contentDescription="@string/action_increase"
            android:padding="9dp"
            android:src="@drawable/ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:text="@string/detail_add_cart"
            app:icon="@drawable/ic_cart"
            app:iconGravity="textStart"
            app:iconTint="@color/rs_white" />
    </LinearLayout>
</LinearLayout>
